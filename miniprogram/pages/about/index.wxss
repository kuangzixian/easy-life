.about-hero { display: flex; flex-direction: column; align-items: center; padding: 42rpx 0 50rpx; }
.about-logo { width: 112rpx; height: 112rpx; border-radius: 30rpx; background: #183F35; display: flex; align-items: center; justify-content: center; color: #E7EDA9; font-size: 61rpx; font-weight: 500; position: relative; }
.logo-dot { position: absolute; width: 11rpx; height: 11rpx; border-radius: 50%; background: #DDEA9B; right: 17rpx; top: 18rpx; }
.about-title { font-size: 47rpx; font-weight: 600; letter-spacing: 5rpx; margin-top: 22rpx; }
.about-tagline { font-size: 25rpx; color: #839473; margin-top: 10rpx; }
.version-pill { background: #E9EDDC; color: #8F9B7C; font-size: 18rpx; padding: 6rpx 18rpx; border-radius: 40rpx; margin-top: 18rpx; }
.about-section { padding: 35rpx 0; border-top: 1rpx solid #DDE4D1; }
.about-section-heading { display: flex; justify-content: space-between; align-items: center; font-size: 30rpx; font-weight: 500; margin-bottom: 24rpx; }
.about-section-heading text:last-child { font-size: 19rpx; color: #A8B39A; letter-spacing: 2rpx; }
.about-copy { font-size: 26rpx; line-height: 1.9; color: #7D8B70; margin-bottom: 22rpx; }
.credit-box { background: #EDEFE2; border-radius: 20rpx; padding: 25rpx; margin: 26rpx 0 14rpx; }
.credit-label { font-size: 18rpx; color: #98A687; margin-bottom: 8rpx; }
.credit-name { color: #687D57; font-size: 25rpx; line-height: 1.7; }
.credit-meta { font-size: 20rpx; color: #98A687; margin-top: 14rpx; }
.about-link { display: flex; justify-content: space-between; align-items: center; text-align: left; border-bottom: 1rpx solid #E6EADB; padding: 22rpx 0; font-size: 25rpx; color: #6D805A; }
.about-link text:last-child { font-size: 21rpx; color: #96A582; white-space: nowrap; margin-left: 20rpx; }
.license-copy { font-size: 22rpx; margin-top: 24rpx; color: #99A38D; }
.version-note { font-size: 20rpx; color: #A1AA95; line-height: 1.9; }
.privacy-points > view { display: flex; align-items: baseline; gap: 15rpx; margin-bottom: 20rpx; font-size: 25rpx; line-height: 1.8; color: #7A8C6A; }
.privacy-dot { flex-shrink: 0; width: 6rpx; height: 6rpx; background: #A7B58D; border-radius: 50%; }
.data-summary { background: #EDEFE2; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; gap: 76rpx; padding: 27rpx; margin-top: 30rpx; }
.data-summary > view:not(.data-rule) { text-align: center; display: flex; flex-direction: column; font-size: 19rpx; color: #99A587; }
.data-number { font-size: 39rpx; color: #6D8257; margin-bottom: 4rpx; }
.data-rule { width: 1rpx; height: 60rpx; background: #D8DFC9; }
.clear-data-button { color: #8C947E; font-size: 24rpx; padding: 22rpx; margin-top: 16rpx; border: 1rpx solid #DEE4D1; border-radius: 16rpx; }
.data-note { margin-top: 16rpx; text-align: center; font-size: 19rpx; }
.operator-row { display: flex; justify-content: space-between; gap: 20rpx; padding: 17rpx 0; font-size: 23rpx; color: #8B9A7A; }
.operator-row text:last-child { text-align: right; color: #718660; }
.contact-value { display: block; margin-top: 12rpx; font-size: 22rpx; color: #8E9D7A; word-break: break-all; }
.about-closing { text-align: center; color: #899976; font-size: 27rpx; line-height: 1.9; padding: 28rpx 0 0; }
