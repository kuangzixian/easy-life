page { background: #F8F6EF; color: #183F35; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif; font-size: 28rpx; line-height: 1.6; }
view, text, input, button, scroll-view, swiper, swiper-item { box-sizing: border-box; }
button { margin: 0; padding: 0; font: inherit; color: inherit; line-height: inherit; border-radius: 0; background: transparent; }
button::after { border: 0; }
button[disabled] { color: #9AA298 !important; background: #E9EAE2 !important; }
button:active, .tap:active { opacity: .73; }
.page { padding: 0 40rpx 44rpx; padding-bottom: calc(44rpx + env(safe-area-inset-bottom)); }
.nav { display: flex; align-items: center; gap: 16rpx; }
.brand-mark { width: 31rpx; height: 31rpx; border: 2rpx solid #183F35; border-radius: 50%; position: relative; }
.brand-mark::after { content: ''; position: absolute; width: 13rpx; height: 13rpx; background: #183F35; border-radius: 50%; left: 7rpx; top: 7rpx; }
.brand { font-size: 25rpx; font-weight: 600; letter-spacing: 3rpx; }
.nav-back { width: 54rpx; height: 64rpx; display: flex; align-items: center; font-size: 42rpx; font-weight: 300; }
.nav-label { font-size: 26rpx; font-weight: 500; }
.eyebrow { font-size: 20rpx; font-weight: 600; letter-spacing: 4rpx; color: #7B8B79; }
.page-heading { font-size: 58rpx; line-height: 1.25; letter-spacing: -2rpx; font-weight: 600; margin: 20rpx 0 16rpx; }
.page-subtitle { font-size: 26rpx; color: #7E8679; line-height: 1.7; }
.section-heading { display: flex; align-items: center; justify-content: space-between; margin: 48rpx 0 24rpx; }
.section-title { font-size: 32rpx; font-weight: 600; letter-spacing: 1rpx; }
.quiet-link { color: #6E7A6A; font-size: 23rpx; padding: 10rpx 0 10rpx 20rpx; }
.arrow { font-size: 32rpx; font-weight: 300; }
.pill { display: inline-flex; align-items: center; padding: 6rpx 16rpx; border-radius: 30rpx; font-size: 21rpx; line-height: 1.6; background: #EAEDE1; color: #61725D; }
.primary-button { background: #183F35; color: #FAF9F1; border-radius: 20rpx; padding: 24rpx 30rpx; font-size: 28rpx; font-weight: 500; text-align: center; }
.secondary-button { background: #EAEDE1; color: #183F35; border-radius: 20rpx; padding: 24rpx 30rpx; font-size: 28rpx; font-weight: 500; text-align: center; }
.empty { margin: 48rpx 0; padding: 56rpx 32rpx; background: #F0F0E7; border: 1rpx solid #E4E6DA; border-radius: 24rpx; text-align: center; }
.empty-symbol { color: #87977A; font-size: 64rpx; font-weight: 200; line-height: 1; margin-bottom: 24rpx; }
.empty-title { font-size: 31rpx; font-weight: 500; }
.empty-copy { font-size: 25rpx; color: #778171; margin: 14rpx 0 0; }
.small-note { font-size: 22rpx; line-height: 1.75; color: #919587; }
.entry-row { background: #FFFEF9; border: 1rpx solid #E7E8DE; border-radius: 22rpx; padding: 28rpx; margin-bottom: 16rpx; }
.entry-meta { display: flex; justify-content: space-between; gap: 14rpx; color: #85917C; font-size: 20rpx; letter-spacing: 1rpx; margin-bottom: 14rpx; }
.entry-title { font-size: 31rpx; font-weight: 550; line-height: 1.5; }
.entry-summary { color: #7A8375; font-size: 25rpx; line-height: 1.75; margin-top: 14rpx; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.entry-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 22rpx; color: #6C7C61; font-size: 22rpx; }
.separator { height: 1rpx; background: #DFE4D6; margin: 36rpx 0; }
.footer-line { display: flex; align-items: center; justify-content: center; gap: 14rpx; margin-top: 44rpx; color: #9BA08F; font-size: 18rpx; letter-spacing: 3rpx; }
.footer-line::before, .footer-line::after { content: ''; display: block; height: 1rpx; width: 44rpx; background: #DDE1D3; }
.tag-list { display: flex; flex-wrap: wrap; gap: 10rpx; }
.visually-label { color: #7C8973; font-size: 22rpx; }
