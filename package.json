  "private": true,
  "description": "匡子闲学 — 有出处的生活指南，小程序与手机网页",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "content": "node scripts/import-content.mjs",
    "test": "node --test tests/*.test.cjs",
